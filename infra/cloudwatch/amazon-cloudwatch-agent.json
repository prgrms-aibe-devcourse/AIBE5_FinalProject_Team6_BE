{
  "logs": {
    "logs_collected": {
      "journald": {
        "collect_list": [
          {
            "log_group_name": "/fandrops/prod",
            "log_stream_name": "{instance_id}",
            "filters": [
              {
                "type": "include",
                "expression": "SYSLOG_IDENTIFIER=fandrops"
              }
            ]
          }
        ]
      }
    },
    "force_flush_interval": 15
  }
}
