{
  "priority": 5,
  "request": {
    "method": "POST",
    "url": "/v1/payments/confirm",
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.paymentKey =~ /^error-.*/)]" }
    ]
  },
  "response": {
    "status": 500,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "code": "PROVIDER_ERROR",
      "message": "PG사 서버 오류가 발생했습니다."
    }
  }
}
